# LLM backends, tried in order until one answers (JSON list; defaults to local Ollama)
# PLANNER_LLM_ENDPOINTS=[{"name":"local-gpu","base_url":"http://localhost:11434/v1","model":"qwen3:4b-instruct"}]
# PLANNER_MAX_REJECTIONS=3

# Default model: "endpoints" (the list above) or "zerogpu" (Qwen3 in-process; the Space sets it)
# PLANNER_BACKEND=endpoints
